# Anthropic API key used for grounded chat and the eval harness's LLM-judge.
# Get one at https://console.anthropic.com/  -- never commit a real key.
ANTHROPIC_API_KEY=

# Model used for chat answers, delta LLM-assist, and eval judging.
# Swap freely -- everything reads this, nothing hardcodes a model name.
LLM_MODEL=claude-sonnet-5

# Optional: separate, cheaper/faster model for the eval LLM-judge.
# Falls back to LLM_MODEL if unset.
JUDGE_MODEL=

# Delta alignment thresholds (0-1). Lower MATCH_MIN = more permissive matching.
DELTA_MATCH_MIN=0.35
DELTA_MOVE_THRESHOLD_PX=12

# Retrieval
CHAT_TOP_K=8

# Cost table ($ per 1M tokens) used for telemetry cost estimates -- update if you
# change LLM_MODEL to a model with different pricing.
PRICE_INPUT_PER_1M=3.00
PRICE_OUTPUT_PER_1M=15.00
